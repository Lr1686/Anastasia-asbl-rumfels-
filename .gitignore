# 🛡️ Sentinel: Security baseline - Ignore secrets and sensitive files
.env
.env.*
!.env.example
*.key
*.pem
*.secret
secrets.json
.token
.credentials

# 🛡️ Sentinel: Shell history and sensitive system files
.bash_history
.zsh_history
.python_history
.ssh/
.gnupg/
.netrc
.npmrc
.yarnrc

# 🛡️ Sentinel: Certificate and key formats
*.p12
*.pfx
*.gpg
*.crt
*.csr

# System files
.DS_Store

# 🛡️ Sentinel: Diagnostic and execution logs to prevent sensitive info leakage
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 🛡️ Sentinel: IDE and local configurations
.idea/
.vscode/
*.swp

# 🛡️ Sentinel: Python cache and bytecode files to prevent binary leakage
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
