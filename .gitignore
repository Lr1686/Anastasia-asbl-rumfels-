# 🛡️ Sentinel: Security baseline - Ignore secrets and sensitive files
.env
.env.*
!.env.example
*.key
*.pem
*.secret
secrets.json
.token
.credentials

# 🛡️ Sentinel: Shell history and sensitive system files
.bash_history
.zsh_history
.python_history
.ssh/
.gnupg/
.netrc
.npmrc
.yarnrc

# 🛡️ Sentinel: Certificate and key formats
*.p12
*.pfx
*.gpg
*.crt
*.csr

# System and log files
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary test/verification artifacts
verification_screenshot.png

# Python bytecode and cache directories
__pycache__/
*.pyc
*.pyo
.pytest_cache/
