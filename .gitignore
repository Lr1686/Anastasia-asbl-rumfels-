# 🛡️ Sentinel: Security baseline - Ignore secrets and sensitive files
.env
.env.*
!.env.example
*.key
*.pem
*.secret
secrets.json
.token
.credentials

# 🛡️ Sentinel: Shell history and sensitive system files
.bash_history
.zsh_history
.python_history
.ssh/
.gnupg/
.netrc
.npmrc
.yarnrc

# 🛡️ Sentinel: Certificate and key formats
*.p12
*.pfx
*.gpg
*.crt
*.csr

# System files
.DS_Store

# Diagnostic and execution logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python bytecode and cache directories
__pycache__/
*.pyc
*.pyo
.pytest_cache/
